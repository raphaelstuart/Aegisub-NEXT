<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AegiNext.Desktop</RootNamespace>
    <AssemblyName>aegi-next</AssemblyName>
    <Product>AegiNext</Product>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AegiNext.Desktop.Tests" />
    <InternalsVisibleTo Include="AegiNext.Desktop.Ui.Tests" />
    <InternalsVisibleTo Include="AegiNext.Preview.Benchmarks" />
    <ProjectReference Include="../AegiNext.Media/AegiNext.Media.csproj" />
    <ProjectReference Include="../AegiNext.Rendering/AegiNext.Rendering.csproj" />
    <ProjectReference Include="../AegiNext.Application/AegiNext.Application.csproj" />
    <ProjectReference Include="../AegiNext.ExportWorker/AegiNext.ExportWorker.csproj" ReferenceOutputAssembly="false" Private="false" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="Markdown.Avalonia.Tight" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/AppIcon.ico" />
    <AvaloniaResource Include="Assets/AppIcon-256.png" />
    <None Update="I18n/Languages/*.json">
      <TargetPath>i18n/%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Target Name="ResolveExportWorkerTarget">
    <MSBuild Projects="../AegiNext.ExportWorker/AegiNext.ExportWorker.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="_ExportWorkerTarget" />
    </MSBuild>
  </Target>
  <Target Name="CopyExportWorker" AfterTargets="Build" DependsOnTargets="ResolveExportWorkerTarget">
    <ItemGroup>
      <_ExportWorkerFiles Include="$([System.IO.Path]::GetDirectoryName('%(_ExportWorkerTarget.Identity)'))/%(_ExportWorkerTarget.Filename)*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExportWorkerFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishExportWorker" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="ResolveExportWorkerTarget" Condition="'$(AegiNextPublishWorkerSeparately)' != 'true'">
    <PropertyGroup>
      <_WorkerPublishDirectory>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'worker-publish', '$(Configuration)', '$(TargetFramework)', '$(RuntimeIdentifier)'))/</_WorkerPublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="../AegiNext.ExportWorker/AegiNext.ExportWorker.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(_WorkerPublishDirectory);AegiNextPublishWorkerSeparately=true" />
    <ItemGroup>
      <_WorkerPublishFile Include="$(_WorkerPublishDirectory)%(_ExportWorkerTarget.Filename)*" />
    </ItemGroup>
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_WorkerPublishFile)">
        <RelativePath>%(_WorkerPublishFile.Filename)%(_WorkerPublishFile.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
