<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markup="using:Avalonia.Markup.Xaml.MarkupExtensions"
        xmlns:shortcuts="using:AegiNext.Desktop.Shortcuts"
        xmlns:presets="using:AegiNext.Core.Presets"
        xmlns:controls="using:AegiNext.Desktop.Controls.Common"
        xmlns:settings="using:AegiNext.Desktop.Settings"
        xmlns:appearance="using:AegiNext.Desktop.Settings.Appearance"
        xmlns:shortcutPages="using:AegiNext.Desktop.Settings.Shortcuts"
        xmlns:stylePages="using:AegiNext.Desktop.Settings.Styles"
        xmlns:effectPages="using:AegiNext.Desktop.Settings.Effects"
        xmlns:exportPages="using:AegiNext.Desktop.Settings.Export"
        xmlns:transferPages="using:AegiNext.Desktop.Settings.Transfer"
        xmlns:colorPages="using:AegiNext.Desktop.Settings.Colors"
        xmlns:colorTagPages="using:AegiNext.Desktop.Settings.ColorTags"
        xmlns:mediaPages="using:AegiNext.Desktop.Settings.Media"
        xmlns:projectPages="using:AegiNext.Desktop.Settings.Projects"
        xmlns:previewPages="using:AegiNext.Desktop.Settings.Preview"
        xmlns:audioPages="using:AegiNext.Desktop.Settings.AudioAnalysis"
        xmlns:taskPages="using:AegiNext.Desktop.Settings.Tasks"
        xmlns:updatePages="using:AegiNext.Desktop.Settings.Updates"
        xmlns:timingPages="using:AegiNext.Desktop.Settings.TimingPostProcessor"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        x:Class="AegiNext.Desktop.Settings.SettingsWindow" x:DataType="settings:SettingsWindowViewModel"
        Classes="business-surface" Title="{Binding Title}"
        Width="980" Height="720" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SettingsBackground}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SettingsBackground">#F4F5F8</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsSurface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsBorder">#DFE3EB</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsMuted">#637087</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsError">#B42318</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SettingsBackground">#151920</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsSurface">#1D232E</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsBorder">#343D4D</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsMuted">#A5B1C6</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsError">#FF9A9A</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Padding" Value="{StaticResource WorkbenchButtonPadding}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="{StaticResource WorkbenchControlHeight}" />
      <Setter Property="FontSize" Value="{StaticResource WorkbenchBodyFontSize}" />
    </Style>
    <Style Selector="TextBox, NumericUpDown">
      <Setter Property="MinHeight" Value="{StaticResource WorkbenchControlHeight}" />
      <Setter Property="FontSize" Value="{StaticResource WorkbenchBodyFontSize}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="{StaticResource WorkbenchControlHeight}" />
      <Setter Property="FontSize" Value="{StaticResource WorkbenchBodyFontSize}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.field">
      <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource SettingsMuted}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,8" /><Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SettingsSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorder}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*">
    <controls:WindowTitleBar Name="SettingsTitleBar" Title="{Binding Title}" />
    <Grid Grid.Row="1" ColumnDefinitions="208,*">
      <Border BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="0,0,1,0" Padding="12,16">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <TextBlock Classes="heading" Text="{Loc Key=Settings.Settings}" Margin="12,0" FontSize="20" FontWeight="SemiBold" />
          <ListBox Name="Navigation" Grid.Row="1" IsEnabled="{Binding IsNavigationAvailable}"
                   Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectedValueBinding="{markup:CompiledBinding DataContext, DataType={x:Type ListBoxItem}}"
                   SelectedValue="{Binding CurrentPage, Mode=TwoWay}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
              <Style Selector="ListBoxItem.navigation-section">
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
              </Style>
              <Style Selector="ListBoxItem.navigation-section.first">
                <Setter Property="Margin" Value="0" />
              </Style>
              <Style Selector="TextBlock.navigation-section-title">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
              <Style Selector="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              </Style>
            </ListBox.Styles>
            <ListBoxItem Classes="navigation-section first">
              <TextBlock Classes="navigation-section-title" Text="{Loc Key=Settings.NavigationGeneral}" />
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.APPEARANCE}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="ThemeLightDark" />
                <TextBlock Text="{Loc Key=Settings.Appearance}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.COLORS}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="Palette" />
                <TextBlock Text="{Loc Key=Settings.Colors}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.SHORTCUTS}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="Keyboard" />
                <TextBlock Text="{Loc Key=Settings.Shortcuts}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.TASKS}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="FormatListBulleted" />
                <TextBlock Text="{Loc Key=Settings.Tasks}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.UPDATES}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="Update" />
                <TextBlock Text="{Loc Key=Settings.Updates}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Classes="navigation-section">
              <TextBlock Classes="navigation-section-title" Text="{Loc Key=Settings.NavigationSubtitles}" />
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.SUBTITLE_COLOR_TAGS}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="TagOutline" />
                <TextBlock Text="{Loc Key=Settings.SubtitleColorTags}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.STYLES}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="FormatText" />
                <TextBlock Text="{Loc Key=Settings.Styles}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.EFFECTS}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="Creation" />
                <TextBlock Text="{Loc Key=Settings.Effects}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.TIMING_POST_PROCESSOR}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="ClockOutline" />
                <TextBlock Text="{Loc Key=Settings.TimingNavigation}" VerticalAlignment="Center"
                           ToolTip.Tip="{Loc Key=Settings.TimingPostProcessor}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Classes="navigation-section">
              <TextBlock Classes="navigation-section-title" Text="{Loc Key=Settings.NavigationMedia}" />
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.MEDIA}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="PlayBoxOutline" />
                <TextBlock Text="{Loc Key=Settings.Media}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.PREVIEW}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="Play" />
                <TextBlock Text="{Loc Key=Settings.Preview}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.AUDIO_ANALYSIS}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="Waveform" />
                <TextBlock Text="{Loc Key=Settings.AudioAnalysis}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Classes="navigation-section">
              <TextBlock Classes="navigation-section-title" Text="{Loc Key=Settings.NavigationProjectData}" />
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.PROJECTS}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="FolderOpenOutline" />
                <TextBlock Text="{Loc Key=Settings.Projects}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.EXPORT_PRESETS}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="Export" />
                <TextBlock Text="{Loc Key=Settings.ExportPresets}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem DataContext="{x:Static settings:SettingsPage.TRANSFER}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Width="18" Height="18" Kind="Import" />
                <TextBlock Text="{Loc Key=Settings.TransferNavigation}" VerticalAlignment="Center"
                           ToolTip.Tip="{Loc Key=Settings.Transfer}" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="24,20" RowSpacing="16">
        <TextBlock Name="PageTitle" Classes="heading" Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" />
        <Grid Grid.Row="1" IsVisible="{Binding IsAppearanceVisible}">
          <appearance:AppearanceSettingsView Name="AppearanceView" DataContext="{Binding Appearance}"
                                             IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsShortcutsVisible}">
          <shortcutPages:ShortcutSettingsView Name="ShortcutsView" DataContext="{Binding Shortcuts}"
                                              IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsStylesVisible}">
          <stylePages:StyleSettingsView Name="StylesView" DataContext="{Binding Styles}"
                                        IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsEffectsVisible}">
          <effectPages:EffectSettingsView Name="EffectsView" DataContext="{Binding Effects}"
                                         IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsColorsVisible}">
          <colorPages:ColorsSettingsView Name="ColorsView" DataContext="{Binding Colors}"
                                         IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsColorTagsVisible}">
          <colorTagPages:SubtitleColorTagsSettingsView Name="ColorTagsView" DataContext="{Binding ColorTags}"
                                                     IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsMediaVisible}">
          <mediaPages:MediaSettingsView Name="MediaView" DataContext="{Binding Media}"
                                       IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsProjectsVisible}">
          <projectPages:ProjectSettingsView Name="ProjectsView" DataContext="{Binding Projects}"
                                           IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsPreviewVisible}">
          <previewPages:PreviewSettingsView Name="PreviewView" DataContext="{Binding Preview}"
                                           IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsTimingPostProcessorVisible}">
          <timingPages:TimingPostProcessorSettingsView Name="TimingPostProcessorView" DataContext="{Binding TimingPostProcessor}"
                                                     IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsExportPresetsVisible}">
          <exportPages:ExportSettingsView Name="ExportPresetsView" DataContext="{Binding ExportPresets}"
                                          IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsTransferVisible}">
          <transferPages:UserSettingsTransferView Name="TransferView" DataContext="{Binding Transfer}"
                                                 IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsTasksVisible}">
          <taskPages:TaskSettingsView Name="TasksView" DataContext="{Binding Tasks}"
                                     IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsAudioAnalysisVisible}">
          <audioPages:AudioAnalysisSettingsView Name="AudioAnalysisView" DataContext="{Binding AudioAnalysis}"
                                               IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsUpdatesVisible}">
          <updatePages:UpdateSettingsView Name="UpdatesView" DataContext="{Binding Updates}"
                                         IsVisible="{Binding $parent[Grid].IsVisible}" />
        </Grid>
        <TextBlock Name="SettingsError" Grid.Row="2" Text="{Binding Error}"
                   Foreground="{DynamicResource SettingsError}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                   MaxHeight="64" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Grid>
  </Grid>
</Window>
