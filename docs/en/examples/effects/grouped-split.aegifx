# Literal delimiters remain in the text and are excluded from the animated groups.
effect "grouped-split" version 2
short-clip compress

scope phrases current
    unit split("、", ",")
    stagger 60ms
    segment pulse fixed 150ms pingpong
        at 0 scale base ease-in-out
        at 1 scale factor(1.25, 1.25)
    end
    segment rest flex 1
    end
end
