# A word is a consecutive non-whitespace run; spaces keep their original layout.
effect "grouped-words" version 2
short-clip compress

scope words current
    unit word
    stagger 60ms
    segment pulse fixed 150ms pingpong
        at 0 scale base ease-in-out
        at 1 scale factor(1.25, 1.25)
    end
    segment rest flex 1
    end
end
